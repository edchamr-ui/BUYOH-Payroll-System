# Runtime mode: development, testing, or production
APP_ENV=development
FLASK_DEBUG=false

# Generate a production key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret

# Prefer one complete database URL.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/buyoh_payroll

# Alternatively, remove DATABASE_URL and provide every DATABASE_* value.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=

# HTTPS deployments must keep secure cookies enabled.
SESSION_COOKIE_SECURE=false

# Optional outbound email configuration.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
